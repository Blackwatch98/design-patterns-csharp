## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET
*.dll
*.exe
*.pdb
*.cache
*.mdb
*.opendb
*.VC.db
*.dbmdl

# Test results
[Tt]est[Rr]esult*/
[Bb]enchmarkDotNet.Artifacts/

# Visual Studio files
.vs/

# Visual Studio Code
.vscode/

# Rider / JetBrains
.idea/

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Coverage
coverage/
coverage.xml
*.coverage
*.coveragexml

# Generated files
Generated/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Publish output
publish/

# Local environment files
.env
.env.*

# Optional: ignore markdown export/temp files
*.tmp
*.bak